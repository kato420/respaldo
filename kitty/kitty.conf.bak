# ==========================================
#               Fuentes
# ==========================================
font_family      JetBrainsMono NF
bold_font        JetBrainsMono NF Bold
italic_font      JetBrainsMono NF Italic
bold_italic_font JetBrainsMono Bold Italic
font_size 10.0

# ==========================================
#         Renderizado y Cursor
# ==========================================
line_height 1.1
letter_spacing 0.0
font_features JetBrainsMonoNF-Medium +zero +calt +liga
cursor_shape block
shell_integration no-cursor
cursor_blink_interval 0.5
text_composition_strategy platform
macos_thinner_scripts yes
disable_ligatures cursor
background_opacity 0.95

# ==========================================
#             Comportamiento
# ==========================================
copy_on_select clipboard
strip_trailing_spaces smart
enable_audio_bell no
visual_bell_duration 0.5
bell_on_tab "🔔 "
remember_window_size yes
remember_window_position yes

# ==========================================
#               Ventana
# ==========================================
draw_minimal_borders yes
window_margin_width 2

# Colores de Borde
# active_border_color #adbac7
# inactive_border_color #22272e

# ==========================================
#      Barra de Pestañas (Bubble Montys)
# ==========================================
tab_bar_style custom
tab_bar_align center
active_tab_font_style bold
inactive_tab_font_style normal
tab_bar_min_tabs 1
tab_bar_margin_width 4
tab_bar_margin_height 2.0 0.0
tab_title_template " {index} {title[:18]} "
active_tab_title_template " {index}  {title[:18]} "

# ==========================================
#           Layouts (Diseño)
# ==========================================
# Habilitar 'splits' para dividir y 'stack' para el modo focus
enabled_layouts splits,stack

# ==========================================
#           Atajos de Teclado
# ==========================================
# Pestañas (Abrir en la carpeta actual)
map ctrl+shift+t launch --cwd=current --type=tab

# ¡NUEVO! Sobrescribir el atajo por defecto de nueva ventana para usar la ruta actual
map ctrl+shift+enter launch --cwd=current

# # Splits explícitos en la carpeta actual
# map ctrl+shift+v launch --location=vsplit --cwd=current
# map ctrl+shift+h launch --location=hsplit --cwd=current

# Moverse entre Splits (Alt + Flechas)
map alt+left neighboring_window left
map alt+right neighboring_window right
map alt+up neighboring_window up
map alt+down neighboring_window down

# Modo Focus / Zoom (Pantalla completa temporal)
map ctrl+shift+z toggle_layout stack

# Modo Focus / Zoom (Pantalla completa temporal)
map ctrl+shift+z toggle_layout stack


map ctrl+shift+a launch sessions
map ctrl+shift+i launch spring-init

# ==========================================
#                 Tema
# ==========================================
# BEGIN_KITTY_THEME
# Adwaita darker
include current-theme.conf
# END_KITTY_THEME
